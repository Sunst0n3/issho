[
  { "id": "s-s1-001", "jp": "きょうはいい{日|ひ}でした。", "en": "Today was a good day.", "grammar": ["wa-desu", "adjective-past"] },
  { "id": "s-s1-002", "jp": "{一日|いちにち}ゆっくりしました。", "en": "I took it easy all day.", "grammar": ["masu-forms", "masu-past"] },
  { "id": "s-s1-003", "jp": "このえほんの{王|おう}さまはやさしいです。", "en": "The king in this picture book is kind.", "grammar": ["kore-sore-are", "no-possession", "i-adjectives"] },
  { "id": "s-s1-004", "jp": "{玉|たま}ねぎを{一|ひと}つください。", "en": "One onion, please.", "grammar": ["wo-object", "counting-tsu"] },
  { "id": "s-s1-005", "jp": "この{国|くに}には{王|おう}さまがいます。", "en": "This country has a king.", "grammar": ["kore-sore-are", "arimasu-imasu"] },
  { "id": "s-s1-006", "jp": "あの{人|ひと}はだれですか。", "en": "Who is that person?", "grammar": ["kore-sore-are", "wa-desu", "ka-question"] },
  { "id": "s-s1-007", "jp": "えきで{会|あ}いましょう。", "en": "Let's meet at the station.", "grammar": ["de-place-means", "masenka-mashou"] },
  { "id": "s-s1-008", "jp": "うちのねこは{十|じゅっ}さいです。", "en": "Our cat is ten years old.", "grammar": ["no-possession", "wa-desu"] },
  { "id": "s-s1-009", "jp": "ふとんを{日|ひ}に{干|ほ}しましょうか。", "en": "Shall we put the futon out in the sun?", "grammar": ["wo-object", "masenka-mashou"] },
  { "id": "s-s1-010", "jp": "お{年玉|としだま}をもらいました。", "en": "I got New Year's money.", "grammar": ["wo-object", "masu-forms", "masu-past"] },
  { "id": "s-s1-011", "jp": "けっこんして{二年|にねん}になります。", "en": "It's been two years since we got married.", "grammar": ["te-form"] },
  { "id": "s-s1-012", "jp": "{大|おお}きいピザを{一|ひと}つください。", "en": "One large pizza, please.", "grammar": ["i-adjectives", "counting-tsu"] },
  { "id": "s-s1-013", "jp": "{大|おお}きい{木|き}ですね。", "en": "What a big tree.", "grammar": ["i-adjectives"] },
  { "id": "s-s1-014", "jp": "わたしは{日本人|にほんじん}じゃないです。", "en": "I'm not Japanese.", "grammar": ["wa-desu", "ja-nai-desu"] },
  { "id": "s-s1-015", "jp": "{口|くち}を{大|おお}きくあけてください。", "en": "Please open your mouth wide.", "grammar": ["wo-object", "te-kudasai"] },
  { "id": "s-s1-016", "jp": "かばんの{中|なか}に{本|ほん}があります。", "en": "There's a book in the bag.", "grammar": ["no-possession", "arimasu-imasu"] },
  { "id": "s-s1-017", "jp": "{長|なが}い{一日|いちにち}でした。", "en": "It was a long day.", "grammar": ["i-adjectives", "adjective-past"] },
  { "id": "s-s1-018", "jp": "{二人|ふたり}で{山|やま}にのぼりたいです。", "en": "I want the two of us to climb a mountain.", "grammar": ["ni-time-place", "tai-want"] },
  { "id": "s-s1-019", "jp": "{山|やま}から{日|ひ}が{出|で}ました。", "en": "The sun came up over the mountain.", "grammar": ["kara-made", "masu-forms"] },
  { "id": "s-s1-020", "jp": "{日本|にほん}に{三日|みっか}いました。", "en": "We were in Japan for three days.", "grammar": ["arimasu-imasu", "masu-forms"] },
  { "id": "s-s1-021", "jp": "くつに{土|つち}がついています。", "en": "There's dirt on your shoes.", "grammar": ["te-imasu"] },
  { "id": "s-s1-022", "jp": "{山|やま}の{中|なか}にお{寺|てら}があります。", "en": "There's a temple up in the mountains.", "grammar": ["no-possession", "arimasu-imasu"] },
  { "id": "s-s1-023", "jp": "{一時|いちじ}ごろに{会|あ}いましょう。", "en": "Let's meet around one o'clock.", "grammar": ["ni-time-place", "masenka-mashou"] },
  { "id": "s-s1-024", "jp": "じゃあ、{行|い}ってきます。", "en": "Okay, I'm off." },
  { "id": "s-s1-025", "jp": "あしたは{会社|かいしゃ}に{行|い}きません。", "en": "I'm not going into the office tomorrow.", "grammar": ["masu-forms", "ni-time-place"] },
  { "id": "s-s1-026", "jp": "{目|め}がかゆいです。", "en": "My eyes are itchy.", "grammar": ["i-adjectives"] },
  { "id": "s-s1-027", "jp": "あの{山|やま}を{見|み}てください。", "en": "Look at that mountain.", "grammar": ["wo-object", "te-kudasai"] },
  { "id": "s-s1-028", "jp": "きりで{一寸|いっすん}さきも{見|み}えません。", "en": "The fog is so thick I can't see an inch ahead.", "grammar": ["masu-forms"] },
  { "id": "s-s1-029", "jp": "{月|つき}がきれいですね。", "en": "The moon is beautiful, isn't it?", "grammar": ["na-adjectives"] },
  { "id": "s-s1-030", "jp": "{三月|さんがつ}に{日本|にほん}へ{行|い}きます。", "en": "We're going to Japan in March.", "grammar": ["ni-time-place", "he-direction"] },
  { "id": "s-s1-031", "jp": "{八時|はちじ}に{会社|かいしゃ}を{出|で}ます。", "en": "I leave the office at eight.", "grammar": ["ni-time-place", "wo-object"] },
  { "id": "s-s1-032", "jp": "はくぶつかんで{日本刀|にほんとう}を{見|み}ました。", "en": "We saw Japanese swords at the museum.", "grammar": ["de-place-means", "wo-object", "masu-forms"] },
  { "id": "s-s1-033", "jp": "あと{三分|さんぷん}まってください。", "en": "Please wait three more minutes.", "grammar": ["te-kudasai"] },
  { "id": "s-s1-034", "jp": "じゃあ、また{後|あと}で。", "en": "See you later, then." },
  { "id": "s-s1-035", "jp": "{前|まえ}の{会社|かいしゃ}は{大|おお}きかったです。", "en": "My last company was a big one.", "grammar": ["no-possession", "adjective-past"] },
  { "id": "s-s1-036", "jp": "{生|なま}ビールを{二|ふた}つください。", "en": "Two draft beers, please.", "grammar": ["wo-object", "counting-tsu"] },
  { "id": "s-s1-037", "jp": "けっこんきねんびは{五月|ごがつ}{二十日|はつか}です。", "en": "Our wedding anniversary is May 20th.", "grammar": ["wa-desu"] },
  { "id": "s-s1-038", "jp": "お{寺|てら}の{門|もん}は{大|おお}きいです。", "en": "The temple gate is big.", "grammar": ["no-possession", "i-adjectives"] },
  { "id": "s-s1-039", "jp": "{日本|にほん}まで{十二時間|じゅうにじかん}かかります。", "en": "It takes twelve hours to get to Japan.", "grammar": ["kara-made"] },
  { "id": "s-s1-040", "jp": "{本|ほん}はテーブルの{上|うえ}にあります。", "en": "The book is on the table.", "grammar": ["no-possession", "arimasu-imasu"] },
  { "id": "s-s1-041", "jp": "{東口|ひがしぐち}はどこですか。", "en": "Where is the east exit?", "grammar": ["wa-desu", "ka-question"] },
  { "id": "s-s1-042", "jp": "たんじょうびは{四月|しがつ}{八日|ようか}です。", "en": "My birthday is April 8th.", "grammar": ["wa-desu"] },
  { "id": "s-s1-043", "jp": "{今|いま}{行|い}きます！", "en": "Coming right now!", "grammar": ["masu-forms"] },
  { "id": "s-s1-044", "jp": "{門|もん}の{前|まえ}に{立|た}っています。", "en": "I'm standing in front of the gate.", "grammar": ["no-possession", "te-imasu"] },
  { "id": "s-s1-045", "jp": "{新|あたら}しい{会社|かいしゃ}はどうですか。", "en": "How's the new job?", "grammar": ["i-adjectives", "ka-question"] },
  { "id": "s-s1-046", "jp": "{今月|こんげつ}はお{金|かね}がありません。", "en": "We're short on money this month.", "grammar": ["arimasu-imasu"] },
  { "id": "s-s1-047", "jp": "{今日|きょう}は{九時|くじ}にねます。", "en": "I'm going to bed at nine tonight.", "grammar": ["ni-time-place", "masu-forms"] },
  { "id": "s-s1-048", "jp": "さきにおふろに{入|はい}ってね。", "en": "Go ahead and take your bath first.", "grammar": ["te-kudasai", "casual-speech"] },
  { "id": "s-s1-049", "jp": "{手|て}をあらってください。", "en": "Please wash your hands.", "grammar": ["wo-object", "te-kudasai"] },
  { "id": "s-s1-050", "jp": "ピアノが{上手|じょうず}ですね。", "en": "You're good at the piano!", "grammar": ["na-adjectives"] },
  { "id": "s-s1-051", "jp": "{大人|おとな}{二人|ふたり}、{子|こ}ども{一人|ひとり}です。", "en": "Two adults and one child, please." },
  { "id": "s-s1-052", "jp": "わたしたちは{大学|だいがく}で{会|あ}いました。", "en": "We met in college.", "grammar": ["de-place-means", "masu-forms"] },
  { "id": "s-s1-053", "jp": "このソファは{高|たか}かったです。", "en": "This sofa was expensive.", "grammar": ["kore-sore-are", "adjective-past"] },
  { "id": "s-s1-054", "jp": "おつりは{十円|じゅうえん}です。", "en": "Your change is ten yen.", "grammar": ["wa-desu"] },
  { "id": "s-s1-055", "jp": "{二人|ふたり}で{夕日|ゆうひ}を{見|み}ました。", "en": "We watched the sunset together.", "grammar": ["wo-object", "masu-forms", "masu-past"] },
  { "id": "s-s1-056", "jp": "{外|そと}はさむいよ。", "en": "It's cold outside, you know.", "grammar": ["i-adjectives", "casual-speech"] },
  { "id": "s-s1-057", "jp": "{今|いま}、なんて{言|い}いましたか。", "en": "What did you just say?", "grammar": ["masu-forms", "ka-question", "masu-past"] },
  { "id": "s-s1-058", "jp": "{今日|きょう}は{六時|ろくじ}におきました。", "en": "I got up at six today.", "grammar": ["ni-time-place", "masu-forms", "masu-past"] },
  { "id": "s-s1-059", "jp": "いすの{下|した}にねこがいます。", "en": "There's a cat under the chair.", "grammar": ["no-possession", "arimasu-imasu"] },
  { "id": "s-s1-060", "jp": "お{米|こめ}がもうありません。", "en": "We're out of rice.", "grammar": ["arimasu-imasu"] },
  { "id": "s-s1-061", "jp": "{来年|らいねん}もここに{来|き}たいですね。", "en": "I'd love to come here again next year.", "grammar": ["mo-also", "tai-want"] },
  { "id": "s-s1-062", "jp": "{気|き}をつけてね。", "en": "Take care, okay?", "grammar": ["casual-speech"] },
  { "id": "s-s1-063", "jp": "このくつはちょっと{小|ちい}さいです。", "en": "These shoes are a little small.", "grammar": ["kore-sore-are", "i-adjectives"] },
  { "id": "s-s1-064", "jp": "{七時|しちじ}に{東口|ひがしぐち}でまっています。", "en": "I'll be waiting at the east exit at seven.", "grammar": ["ni-time-place", "de-place-means", "te-imasu"] },
  { "id": "s-s1-065", "jp": "ぜんぶで{千円|せんえん}です。", "en": "That's 1,000 yen altogether." },
  { "id": "s-s1-066", "jp": "あついスープで{舌|した}をやけどしました。", "en": "I burned my tongue on hot soup.", "grammar": ["de-place-means", "wo-object", "masu-forms"] },
  { "id": "s-s1-067", "jp": "{後|あと}で{話|はな}しましょう。", "en": "Let's talk later.", "grammar": ["masenka-mashou"] },
  { "id": "s-s1-068", "jp": "{今日|きょう}は{人|ひと}が{多|おお}いね。", "en": "It's really crowded today, huh.", "grammar": ["i-adjectives", "casual-speech"] },
  { "id": "s-s1-069", "jp": "{女|おんな}の{子|こ}が{生|う}まれました。", "en": "A baby girl was born.", "grammar": ["masu-forms", "masu-past"] },
  { "id": "s-s1-070", "jp": "わたしは{乙女|おとめ}ざです。", "en": "I am a Virgo.", "grammar": ["wa-desu"] },
  { "id": "s-s1-071", "jp": "このスーパーは{安|やす}いです。", "en": "This supermarket is cheap.", "grammar": ["kore-sore-are", "i-adjectives"] },
  { "id": "s-s1-072", "jp": "{北口|きたぐち}を{出|で}てください。", "en": "Please go out through the north exit.", "grammar": ["wo-object", "te-kudasai"] },
  { "id": "s-s1-073", "jp": "{午前中|ごぜんちゅう}はうちにいます。", "en": "I'll be home all morning.", "grammar": ["arimasu-imasu"] },
  { "id": "s-s1-074", "jp": "{白|しろ}ワインを{一|いっ}ぱいください。", "en": "A glass of white wine, please.", "grammar": ["wo-object"] },
  { "id": "s-s1-075", "jp": "{百円|ひゃくえん}ショップはべんりです。", "en": "Hundred-yen shops are really handy.", "grammar": ["wa-desu", "na-adjectives"] },
  { "id": "s-s1-076", "jp": "{今|いま}、レポートを{書|か}いています。", "en": "I'm writing a report right now.", "grammar": ["wo-object", "te-imasu"] },
  { "id": "s-s1-077", "jp": "お{先|さき}にどうぞ。", "en": "After you." },
  { "id": "s-s1-078", "jp": "ねこの{名前|なまえ}は「タマ」です。", "en": "The cat's name is Tama.", "grammar": ["no-possession", "wa-desu"] },
  { "id": "s-s1-079", "jp": "{川|かわ}のそばをさんぽしましょう。", "en": "Let's take a walk along the river.", "grammar": ["no-possession", "masenka-mashou"] },
  { "id": "s-s1-080", "jp": "{自分|じぶん}でやります。", "en": "I'll do it myself.", "grammar": ["de-place-means", "masu-forms"] },
  { "id": "s-s1-081", "jp": "キリンは{首|くび}が{長|なが}いです。", "en": "Giraffes have long necks.", "grammar": ["i-adjectives"] },
  { "id": "s-s1-082", "jp": "すみません、{道|みち}にまよいました。", "en": "Excuse me, I'm lost.", "grammar": ["masu-forms", "masu-past"] },
  { "id": "s-s1-083", "jp": "この{川|かわ}の{水|みず}はきれいですね。", "en": "The water in this river is so clear.", "grammar": ["kore-sore-are", "no-possession", "na-adjectives"] },
  { "id": "s-s1-084", "jp": "このケーキ、{半分|はんぶん}ずつにしましょう。", "en": "Let's split this cake half and half.", "grammar": ["kore-sore-are", "masenka-mashou"] },
  { "id": "s-s1-085", "jp": "{田|た}んぼに{水|みず}が{入|はい}っています。", "en": "The rice paddies are full of water.", "grammar": ["te-imasu"] },
  { "id": "s-s1-086", "jp": "もう{力|ちから}が{出|で}ません。", "en": "I've got no energy left.", "grammar": ["masu-forms"] },
  { "id": "s-s1-087", "jp": "{男|おとこ}の{子|こ}と{女|おんな}の{子|こ}、どっちがいい？", "en": "A boy or a girl: which would you like?", "grammar": ["to-with", "casual-speech"] },
  { "id": "s-s1-088", "jp": "{夕日|ゆうひ}が{西|にし}の{山|やま}にしずみます。", "en": "The sun is setting behind the western mountains.", "grammar": ["no-possession", "ni-time-place"] },
  { "id": "s-s1-089", "jp": "{今日|きょう}は{一日中|いちにちじゅう}{雨|あめ}でした。", "en": "It rained all day today.", "grammar": ["wa-desu", "adjective-past"] },
  { "id": "s-s1-090", "jp": "{午後|ごご}から{雨|あめ}がふります。", "en": "It'll start raining in the afternoon.", "grammar": ["kara-made"] },
  { "id": "s-s1-091", "jp": "{電話|でんわ}がなっているよ。", "en": "Your phone's ringing.", "grammar": ["te-imasu", "casual-speech"] },
  { "id": "s-s1-092", "jp": "{電気|でんき}をけしてください。", "en": "Please turn off the light.", "grammar": ["wo-object", "te-kudasai"] },
  { "id": "s-s1-093", "jp": "もう{少|すこ}し{大|おお}きいのはありますか。", "en": "Do you have one that's a little bigger?", "grammar": ["arimasu-imasu", "ka-question"] },
  { "id": "s-s1-094", "jp": "お{父|とう}さんによろしく。", "en": "Say hi to your dad for me." },
  { "id": "s-s1-095", "jp": "となりの{人|ひと}とあいさつを{交|か}わしました。", "en": "I exchanged greetings with our neighbor.", "grammar": ["to-with", "wo-object", "masu-forms"] },
  { "id": "s-s1-096", "jp": "つまは{高校|こうこう}の{先生|せんせい}です。", "en": "My wife is a high school teacher.", "grammar": ["wa-desu", "no-possession"] },
  { "id": "s-s1-097", "jp": "{日本語|にほんご}が{少|すこ}し{分|わ}かります。", "en": "I understand a little Japanese.", "grammar": ["masu-forms"] },
  { "id": "s-s1-098", "jp": "{二人|ふたり}で{日本語|にほんご}を{学|まな}んでいます。", "en": "The two of us are learning Japanese together.", "grammar": ["wo-object", "te-imasu"] },
  { "id": "s-s1-099", "jp": "くつしたに{穴|あな}があいています。", "en": "There's a hole in my sock.", "grammar": ["te-imasu"] },
  { "id": "s-s1-100", "jp": "あしたは{大工|だいく}さんが{来|き}ます。", "en": "The carpenter is coming tomorrow.", "grammar": ["masu-forms"] },
  { "id": "s-s1-101", "jp": "{今日|きょう}は{空|そら}が{高|たか}いですね。", "en": "The sky looks so high and clear today.", "grammar": ["i-adjectives"] },
  { "id": "s-s1-102", "jp": "{山|やま}の{空気|くうき}はおいしいですね。", "en": "The mountain air is so fresh, isn't it?", "grammar": ["no-possession", "i-adjectives"] },
  { "id": "s-s1-103", "jp": "{耳|みみ}がいたいです。", "en": "My ear hurts.", "grammar": ["i-adjectives"] },
  { "id": "s-s1-104", "jp": "ちょっと{聞|き}いて！", "en": "Hey, listen to this!", "grammar": ["te-kudasai", "casual-speech"] },
  { "id": "s-s1-105", "jp": "{日本語|にほんご}のラジオを{聞|き}いています。", "en": "I'm listening to a Japanese radio show.", "grammar": ["no-possession", "wo-object", "te-imasu"] },
  { "id": "s-s1-106", "jp": "ラーメンを{食|た}べませんか。", "en": "Do you want to have ramen?", "grammar": ["wo-object", "masenka-mashou"] },
  { "id": "s-s1-107", "jp": "{食|しょく}パンを{一斤|いっきん}ください。", "en": "One loaf of sandwich bread, please.", "grammar": ["wo-object"] },
  { "id": "s-s1-108", "jp": "ホテルの{夕食|ゆうしょく}は{七時|しちじ}からです。", "en": "Dinner at the hotel starts at seven.", "grammar": ["no-possession", "kara-made"] },
  { "id": "s-s1-109", "jp": "{車|くるま}で{行|い}きましょう。", "en": "Let's go by car.", "grammar": ["de-place-means", "masenka-mashou"] },
  { "id": "s-s1-110", "jp": "あ、{電車|でんしゃ}が{来|き}ました。", "en": "Oh, here comes the train.", "grammar": ["masu-forms", "masu-past"] },

  { "id": "s-k001", "jp": "これはみずですか。", "en": "Is this water?", "grammar": ["kore-sore-are", "ka-question"] },
  { "id": "s-k002", "jp": "それはおちゃです。", "en": "That's tea.", "grammar": ["kore-sore-are", "wa-desu"] },
  { "id": "s-k003", "jp": "トイレはどこですか。", "en": "Where is the restroom?", "grammar": ["wa-desu", "ka-question"] },
  { "id": "s-k004", "jp": "これはいくらですか。", "en": "How much is this?", "grammar": ["kore-sore-are", "ka-question"] },
  { "id": "s-k005", "jp": "あれはなんですか。", "en": "What is that over there?", "grammar": ["kore-sore-are", "ka-question"] },
  { "id": "s-k006", "jp": "このパンはおいしいです。", "en": "This bread is delicious.", "grammar": ["kore-sore-are", "i-adjectives"] },
  { "id": "s-k007", "jp": "このりんごはおいしくないです。", "en": "This apple doesn't taste good.", "grammar": ["kore-sore-are", "i-adjectives"] },
  { "id": "s-k008", "jp": "きょうはさむいです。", "en": "It's cold today.", "grammar": ["wa-desu", "i-adjectives"] },
  { "id": "s-k009", "jp": "きょうはあつくないです。", "en": "It isn't hot today.", "grammar": ["i-adjectives"] },
  { "id": "s-k010", "jp": "あしたもさむいです。", "en": "It'll be cold tomorrow too.", "grammar": ["mo-also", "i-adjectives"] },
  { "id": "s-k011", "jp": "わたしもコーヒーです。", "en": "I'll have coffee too.", "grammar": ["mo-also", "wa-desu"] },
