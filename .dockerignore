# Installed fresh inside the image.
**/node_modules

# Build output and local data never go into the build context.
dist
server/data
issho-data

# public/data/ (committed) is what the image ships. data-raw/, when present, stays in the context
# so a checkout without public/data/ can still build it (see the Dockerfile).

# Secrets and noise.
**/.env
**/.env.*
!**/.env.example
.git
*.log
.DS_Store
