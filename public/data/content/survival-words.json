[{"id":"sw-konnichiwa","kana":"こんにちは","en":"hello; good afternoon","note":"The everyday daytime greeting. The final は is read \"wa\"."},{"id":"sw-arigatou","kana":"ありがとう","en":"thanks (casual)","note":"Casual: friends, family, your partner."},{"id":"sw-arigatougozaimasu","kana":"ありがとうございます","en":"thank you (polite)","note":"Use with strangers, staff and anyone older."},{"id":"sw-sumimasen","kana":"すみません","en":"excuse me","note":"Gets attention, says a polite \"sorry\", or thanks someone for their trouble."},{"id":"sw-hai","kana":"はい","en":"yes (polite)","note":"Also \"I'm listening\" or \"here you go\"."},{"id":"sw-iie","kana":"いいえ","en":"no (polite)","note":"Polite but direct; people often soften a no instead."},{"id":"sw-ohayou","kana":"おはよう","en":"good morning (casual)","note":"To family, friends and your partner."},{"id":"sw-ohayougozaimasu","kana":"おはようございます","en":"good morning (polite)","note":"To neighbors, coworkers and staff."},{"id":"sw-konbanwa","kana":"こんばんは","en":"good evening","note":"The final は is read \"wa\"."},{"id":"sw-oyasumi","kana":"おやすみ","en":"good night (casual)","note":"Said before bed, to family or your partner."},{"id":"sw-oyasuminasai","kana":"おやすみなさい","en":"good night (polite)"},{"id":"sw-sayounara","kana":"さようなら","en":"goodbye (formal)","note":"Sounds formal or final; friends say じゃあね."},{"id":"sw-jaane","kana":"じゃあね","en":"bye (casual)","note":"Casual; between friends and partners."},{"id":"sw-gomennasai","kana":"ごめんなさい","en":"I'm sorry","note":"A heartfelt personal apology. Shortened to ごめん between close friends."},{"id":"sw-daijoubu","kana":"だいじょうぶ","written":"大丈夫","en":"okay; all right","note":"Rising tone asks \"Are you okay?\". だいじょうぶです is also a polite \"no thanks\"."},{"id":"sw-kudasai","kana":"ください","en":"please give me","note":"Goes after the thing you want: みずを ください."},{"id":"sw-onegaishimasu","kana":"おねがいします","written":"お願いします","en":"please (request)","note":"Polite; works on its own when ordering or asking a favor."},{"id":"sw-douzo","kana":"どうぞ","en":"go ahead; here you are","note":"Offering something or letting someone go first."},{"id":"sw-hajimemashite","kana":"はじめまして","written":"初めまして","en":"nice to meet you","note":"Only at a first meeting."},{"id":"sw-yoroshikuonegaishimasu","kana":"よろしくおねがいします","written":"よろしくお願いします","en":"please treat me well; I'm counting on you","note":"Closes introductions, where it works like \"pleased to meet you\", and requests. No exact English match."},{"id":"sw-wakarimasen","kana":"わかりません","written":"分かりません","en":"I don't understand; I don't know","note":"Polite."},{"id":"sw-wakarimashita","kana":"わかりました","written":"分かりました","en":"I understand; got it","note":"Polite. Casual: わかった."},{"id":"sw-mouichido","kana":"もういちど","written":"もう一度","en":"one more time","note":"もういちど おねがいします = could you say that again?"},{"id":"sw-yukkuri","kana":"ゆっくり","en":"slowly","note":"ゆっくり おねがいします = slower, please."},{"id":"sw-itadakimasu","kana":"いただきます","en":"let's eat (said before a meal)","note":"Said with hands together before every meal, even when eating alone."},{"id":"sw-gochisousamadeshita","kana":"ごちそうさまでした","en":"thank you for the meal","note":"Said after eating, to the cook, your host or restaurant staff."},{"id":"sw-ittekimasu","kana":"いってきます","written":"行ってきます","en":"I'm off (when leaving home)","note":"The person leaving says this."},{"id":"sw-itterasshai","kana":"いってらっしゃい","written":"行ってらっしゃい","en":"have a good day (to someone leaving)","note":"The reply to いってきます."},{"id":"sw-tadaima","kana":"ただいま","en":"I'm home","note":"Said when you come back home."},{"id":"sw-okaerinasai","kana":"おかえりなさい","written":"お帰りなさい","en":"welcome home","note":"The reply to ただいま. Casual: おかえり."},{"id":"sw-un","kana":"うん","en":"yeah (casual)","note":"Casual yes; between partners and friends."},{"id":"sw-uun","kana":"ううん","en":"nope (casual)","note":"Casual no, like \"uh-uh\". Longer than うん, which means yes."},{"id":"sw-soudesuka","kana":"そうですか","en":"I see; is that so?","note":"Falling tone = \"I see.\" Rising tone = \"Really?\""},{"id":"sw-ii","kana":"いい","en":"good; nice","note":"いいです can also mean \"no thanks\"; watch the context."},{"id":"sw-chotto","kana":"ちょっと","en":"a little; just a moment","note":"Trailing off with ちょっと… is a soft way to say no."},{"id":"sw-genki","kana":"げんき","written":"元気","en":"well; healthy; energetic","note":"おげんきですか = How have you been? (after some time apart)."},{"id":"sw-watashi","kana":"わたし","written":"私","en":"I; me"},{"id":"sw-anata","kana":"あなた","en":"you","note":"Often avoided; use the person's name instead."},{"id":"sw-namae","kana":"なまえ","written":"名前","en":"name","note":"おなまえは？ = What's your name?"},{"id":"sw-nani","kana":"なに","written":"何","en":"what","note":"Becomes なん before です: なんですか."},{"id":"sw-doko","kana":"どこ","en":"where"},{"id":"sw-itsu","kana":"いつ","en":"when"},{"id":"sw-dare","kana":"だれ","written":"誰","en":"who"},{"id":"sw-ikura","kana":"いくら","en":"how much (price)","note":"いくらですか = How much is it?"},{"id":"sw-nanji","kana":"なんじ","written":"何時","en":"what time","note":"いま なんじ？ = What time is it?"},{"id":"sw-kore","kana":"これ","en":"this (near me)"},{"id":"sw-sore","kana":"それ","en":"that (near you)"},{"id":"sw-are","kana":"あれ","en":"that (over there)"},{"id":"sw-koko","kana":"ここ","en":"here"},{"id":"sw-toire","kana":"トイレ","en":"toilet; restroom","note":"トイレは どこですか = Where's the restroom?"},{"id":"sw-ichi","kana":"いち","written":"一","en":"one (1)"},{"id":"sw-ni","kana":"に","written":"二","en":"two (2)"},{"id":"sw-san","kana":"さん","written":"三","en":"three (3)","note":"Same sound as the name ending さん."},{"id":"sw-yon","kana":"よん","written":"四","en":"four (4)","note":"し also means four, but it sounds like \"death\", so よん is preferred."},{"id":"sw-go","kana":"ご","written":"五","en":"five (5)"},{"id":"sw-roku","kana":"ろく","written":"六","en":"six (6)"},{"id":"sw-nana","kana":"なな","written":"七","en":"seven (7)","note":"Also しち, as in しちじ (7 o'clock)."},{"id":"sw-hachi","kana":"はち","written":"八","en":"eight (8)"},{"id":"sw-kyuu","kana":"きゅう","written":"九","en":"nine (9)","note":"Also く, as in くじ (9 o'clock)."},{"id":"sw-juu","kana":"じゅう","written":"十","en":"ten (10)"},{"id":"sw-hitotsu","kana":"ひとつ","written":"一つ","en":"one (thing)","note":"For ordering and buying: ひとつ ください."},{"id":"sw-futatsu","kana":"ふたつ","written":"二つ","en":"two (things)"},{"id":"sw-hitori","kana":"ひとり","written":"一人","en":"one person; alone"},{"id":"sw-futari","kana":"ふたり","written":"二人","en":"two people; the two of us","note":"ふたりで = together, just the two of us."},{"id":"sw-en","kana":"えん","written":"円","en":"yen","note":"Goes after the number: ひゃく えん = 100 yen."},{"id":"sw-mizu","kana":"みず","written":"水","en":"water","note":"In restaurants say おみず; it is usually free."},{"id":"sw-ocha","kana":"おちゃ","written":"お茶","en":"tea; green tea"},{"id":"sw-koohii","kana":"コーヒー","en":"coffee"},{"id":"sw-gohan","kana":"ごはん","written":"ご飯","en":"rice; meal","note":"Cooked rice, and also a meal in general."},{"id":"sw-pan","kana":"パン","en":"bread","note":"From Portuguese pão."},{"id":"sw-oishii","kana":"おいしい","written":"美味しい","en":"delicious"},{"id":"sw-tamago","kana":"たまご","written":"卵","en":"egg"},{"id":"sw-niku","kana":"にく","written":"肉","en":"meat"},{"id":"sw-sakana","kana":"さかな","written":"魚","en":"fish"},{"id":"sw-yasai","kana":"やさい","written":"野菜","en":"vegetables"},{"id":"sw-kudamono","kana":"くだもの","written":"果物","en":"fruit"},{"id":"sw-ringo","kana":"りんご","en":"apple"},{"id":"sw-mikan","kana":"みかん","en":"mandarin orange"},{"id":"sw-banana","kana":"バナナ","en":"banana"},{"id":"sw-gyuunyuu","kana":"ぎゅうにゅう","written":"牛乳","en":"milk"},{"id":"sw-biiru","kana":"ビール","en":"beer"},{"id":"sw-kanpai","kana":"かんぱい","written":"乾杯","en":"cheers!","note":"The toast before the first sip."},{"id":"sw-kazoku","kana":"かぞく","written":"家族","en":"family"},{"id":"sw-otto","kana":"おっと","written":"夫","en":"(my) husband","note":"Your own husband; someone else's is ごしゅじん."},{"id":"sw-tsuma","kana":"つま","written":"妻","en":"(my) wife","note":"Your own wife; someone else's is おくさん."},{"id":"sw-haha","kana":"はは","written":"母","en":"my mother (to others)","note":"Humble: for your own mother when talking to other people."},{"id":"sw-chichi","kana":"ちち","written":"父","en":"my father (to others)","note":"Humble: for your own father when talking to other people."},{"id":"sw-okaasan","kana":"おかあさん","written":"お母さん","en":"Mom; someone's mother","note":"Polite for other people's mothers; also what you call your own."},{"id":"sw-otousan","kana":"おとうさん","written":"お父さん","en":"Dad; someone's father","note":"Polite for other people's fathers; also what you call your own."},{"id":"sw-kodomo","kana":"こども","written":"子ども","en":"child; children"},{"id":"sw-tomodachi","kana":"ともだち","written":"友達","en":"friend"},{"id":"sw-suki","kana":"すき","written":"好き","en":"like; be fond of","note":"すきです = I like it. Also how people confess love."},{"id":"sw-daisuki","kana":"だいすき","written":"大好き","en":"love; really like","note":"The everyday way to say \"I love you\" to a partner."},{"id":"sw-aishiteru","kana":"あいしてる","written":"愛してる","en":"I love you (deeply)","note":"Heavy and rarely said aloud; save it for big moments."},{"id":"sw-kawaii","kana":"かわいい","written":"可愛い","en":"cute"},{"id":"sw-sugoi","kana":"すごい","en":"amazing; wow","note":"Casual; works for good and surprising things."},{"id":"sw-tanoshii","kana":"たのしい","written":"楽しい","en":"fun; enjoyable"},{"id":"sw-takai","kana":"たかい","written":"高い","en":"expensive; tall"},{"id":"sw-yasui","kana":"やすい","written":"安い","en":"cheap"},{"id":"sw-ookii","kana":"おおきい","written":"大きい","en":"big"},{"id":"sw-chiisai","kana":"ちいさい","written":"小さい","en":"small"},{"id":"sw-samui","kana":"さむい","written":"寒い","en":"cold (weather)"},{"id":"sw-atsui","kana":"あつい","written":"暑い","en":"hot (weather)"},{"id":"sw-tsukareta","kana":"つかれた","written":"疲れた","en":"I'm tired","note":"Casual. Polite: つかれました."},{"id":"sw-otsukaresama","kana":"おつかれさま","written":"お疲れ様","en":"thanks for your hard work","note":"Said after work or any effort, including a study session together."},{"id":"sw-kyou","kana":"きょう","written":"今日","en":"today"},{"id":"sw-ashita","kana":"あした","written":"明日","en":"tomorrow"},{"id":"sw-kinou","kana":"きのう","written":"昨日","en":"yesterday"},{"id":"sw-ima","kana":"いま","written":"今","en":"now"},{"id":"sw-uchi","kana":"うち","written":"家","en":"home; my place","note":"Casual; うちに かえる = go home."},{"id":"sw-eki","kana":"えき","written":"駅","en":"train station"},{"id":"sw-nihongo","kana":"にほんご","written":"日本語","en":"Japanese (language)"},{"id":"sw-eigo","kana":"えいご","written":"英語","en":"English (language)"},{"id":"sw-hontou","kana":"ほんとう","written":"本当","en":"really; true","note":"ほんとう？ = Really?"},{"id":"sw-omedetou","kana":"おめでとう","en":"congratulations","note":"Casual. Polite: おめでとうございます."},{"id":"sw-ganbatte","kana":"がんばって","written":"頑張って","en":"good luck; hang in there","note":"Encouragement before or during something hard."},{"id":"sw-terebi","kana":"テレビ","en":"TV"}]
