// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`PhrasePitchLine > draws one small line per accent phrase (snapshot) 1`] = `"<div class="st-phrase-pitch"><svg width="217" height="38" viewBox="0 0 217 38" role="img" aria-label="Sentence pitch, 3 phrases"><g class="st-pitch-phrase"><polyline class="st-pitch-line" points="9,6 27,18 45,18"></polyline><circle class="st-pitch-dot" cx="9" cy="6" r="2.8"></circle><circle class="st-pitch-dot" cx="27" cy="18" r="2.8"></circle><circle class="st-pitch-dot" cx="45" cy="18" r="2.8"></circle><text class="st-pitch-mora" x="9" y="34" text-anchor="middle" lang="ja">キョ</text><text class="st-pitch-mora" x="27" y="34" text-anchor="middle" lang="ja">ー</text><text class="st-pitch-mora" x="45" y="34" text-anchor="middle" lang="ja">ワ</text></g><g class="st-pitch-phrase"><polyline class="st-pitch-line" points="77,18 95,6"></polyline><circle class="st-pitch-dot" cx="77" cy="18" r="2.8"></circle><circle class="st-pitch-dot" cx="95" cy="6" r="2.8"></circle><text class="st-pitch-mora" x="77" y="34" text-anchor="middle" lang="ja">イ</text><text class="st-pitch-mora" x="95" y="34" text-anchor="middle" lang="ja">ー</text></g><g class="st-pitch-phrase"><polyline class="st-pitch-line" points="127,6 145,18 163,18 181,18 199,18"></polyline><circle class="st-pitch-dot" cx="127" cy="6" r="2.8"></circle><circle class="st-pitch-dot" cx="145" cy="18" r="2.8"></circle><circle class="st-pitch-dot" cx="163" cy="18" r="2.8"></circle><circle class="st-pitch-dot" cx="181" cy="18" r="2.8"></circle><circle class="st-pitch-dot" cx="199" cy="18" r="2.8"></circle><text class="st-pitch-mora" x="127" y="34" text-anchor="middle" lang="ja">テ</text><text class="st-pitch-mora" x="145" y="34" text-anchor="middle" lang="ja">ン</text><text class="st-pitch-mora" x="163" y="34" text-anchor="middle" lang="ja">キ</text><text class="st-pitch-mora" x="181" y="34" text-anchor="middle" lang="ja">デ</text><text class="st-pitch-mora" x="199" y="34" text-anchor="middle" lang="ja">ス</text></g></svg></div>"`;

exports[`PitchLine > draws a atamadaka word as a height line (snapshot) 1`] = `"<svg class="st-pitch st-pitch-md" width="60" height="50" viewBox="0 0 60 50" role="img" aria-label="Pitch: high first mora, then low" data-type="atamadaka"><polyline class="st-pitch-line" points="15,8 45,28"></polyline><circle class="st-pitch-dot" cx="15" cy="8" r="4"></circle><circle class="st-pitch-dot" cx="45" cy="28" r="4"></circle><text class="st-pitch-mora" x="15" y="46" text-anchor="middle" lang="ja">は</text><text class="st-pitch-mora" x="45" y="46" text-anchor="middle" lang="ja">し</text></svg>"`;

exports[`PitchLine > draws a heiban word as a height line (snapshot) 1`] = `"<svg class="st-pitch st-pitch-md" width="120" height="50" viewBox="0 0 120 50" role="img" aria-label="Pitch: flat: low, then high, and the particle stays high" data-type="heiban"><polyline class="st-pitch-line" points="15,28 45,8 75,8 105,8"></polyline><circle class="st-pitch-dot" cx="15" cy="28" r="4"></circle><circle class="st-pitch-dot" cx="45" cy="8" r="4"></circle><circle class="st-pitch-dot" cx="75" cy="8" r="4"></circle><circle class="st-pitch-dot particle" cx="105" cy="8" r="4"></circle><text class="st-pitch-mora" x="15" y="46" text-anchor="middle" lang="ja">さ</text><text class="st-pitch-mora" x="45" y="46" text-anchor="middle" lang="ja">く</text><text class="st-pitch-mora" x="75" y="46" text-anchor="middle" lang="ja">ら</text></svg>"`;

exports[`PitchLine > draws a nakadaka word as a height line (snapshot) 1`] = `"<svg class="st-pitch st-pitch-md" width="150" height="50" viewBox="0 0 150 50" role="img" aria-label="Pitch: rises, then drops inside the word" data-type="nakadaka"><polyline class="st-pitch-line" points="15,28 45,8 75,28 105,28 135,28"></polyline><circle class="st-pitch-dot" cx="15" cy="28" r="4"></circle><circle class="st-pitch-dot" cx="45" cy="8" r="4"></circle><circle class="st-pitch-dot" cx="75" cy="28" r="4"></circle><circle class="st-pitch-dot" cx="105" cy="28" r="4"></circle><circle class="st-pitch-dot" cx="135" cy="28" r="4"></circle><text class="st-pitch-mora" x="15" y="46" text-anchor="middle" lang="ja">あ</text><text class="st-pitch-mora" x="45" y="46" text-anchor="middle" lang="ja">り</text><text class="st-pitch-mora" x="75" y="46" text-anchor="middle" lang="ja">が</text><text class="st-pitch-mora" x="105" y="46" text-anchor="middle" lang="ja">と</text><text class="st-pitch-mora" x="135" y="46" text-anchor="middle" lang="ja">ー</text></svg>"`;

exports[`PitchLine > draws a odaka word as a height line (snapshot) 1`] = `"<svg class="st-pitch st-pitch-md" width="90" height="50" viewBox="0 0 90 50" role="img" aria-label="Pitch: rises and stays high, then the particle drops" data-type="odaka"><polyline class="st-pitch-line" points="15,28 45,8 75,28"></polyline><circle class="st-pitch-dot" cx="15" cy="28" r="4"></circle><circle class="st-pitch-dot" cx="45" cy="8" r="4"></circle><circle class="st-pitch-dot particle" cx="75" cy="28" r="4"></circle><text class="st-pitch-mora" x="15" y="46" text-anchor="middle" lang="ja">は</text><text class="st-pitch-mora" x="45" y="46" text-anchor="middle" lang="ja">し</text></svg>"`;
